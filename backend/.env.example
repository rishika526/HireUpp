# HireUpp Backend Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI / LLM Configuration
# Options: "gemini", "openai", "demo"
LLM_PROVIDER=gemini

# Set your Gemini or OpenAI API Key here:
# Leave blank to enable deterministic DEMO_MODE fallback automatically
GEMINI_API_KEY=
OPENAI_API_KEY=

# Force Demo Mode (deterministic rule-based ATS engine with no external API calls)
DEMO_MODE=true

# Maximum PDF size in Megabytes (default: 10MB)
MAX_PDF_SIZE_MB=10
